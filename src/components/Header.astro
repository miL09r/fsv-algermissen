---
import { site } from "../lib/data";
import { getDb } from "../lib/server/auth";
import { getSiteClubPages } from "../lib/server/club-pages";
import { buildNavigation } from "../lib/server/navigation";
import { getSiteTeams } from "../lib/server/teams";

const db = await getDb(Astro.locals);
const nav = buildNavigation(await getSiteTeams(db), await getSiteClubPages(db));
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Startseite FSV Algermissen">
    <img
      src="https://images.ebcdn.de/club-4844/logo.png?format=webp&height=1200&mode=crop&v=2&width=1200"
      alt=""
      width="54"
      height="54"
      loading="eager"
    />
    <span>
      <strong>{site.name}</strong>
      <small>von 1911 / 1990 e.V.</small>
    </span>
  </a>
  <nav class="main-nav" aria-label="Hauptnavigation">
    {nav.map((item) => (
      <div class:list={["nav-group", item.children && "has-children"]}>
        <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>{item.label}</a>
        {item.children && (
          <>
            <button class="nav-toggle" type="button" aria-label={`${item.label} Untermenue oeffnen`} aria-expanded="false"></button>
            <div class="flyout" aria-label={`${item.label} Unterseiten`}>
              {item.children.map((child) => <a href={child.href}>{child.label}</a>)}
            </div>
          </>
        )}
      </div>
    ))}
  </nav>
</header>

<script is:inline>
  const isMobileNav = () => window.matchMedia("(max-width: 900px)").matches;

  function closeOtherNavGroups(group) {
    document.querySelectorAll(".nav-group.is-open").forEach((otherGroup) => {
      if (otherGroup === group) return;
      otherGroup.classList.remove("is-open");
      otherGroup.querySelector(".nav-toggle")?.setAttribute("aria-expanded", "false");
    });
  }

  function toggleNavGroup(group) {
    const isOpen = group?.classList.toggle("is-open") ?? false;
    group?.querySelector(".nav-toggle")?.setAttribute("aria-expanded", String(isOpen));
    closeOtherNavGroups(group);
  }

  document.querySelectorAll(".nav-toggle").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      toggleNavGroup(button.closest(".nav-group"));
    });
  });

  document.querySelectorAll(".nav-group.has-children").forEach((group) => {
    group.addEventListener("click", (event) => {
      if (!isMobileNav()) return;
      const target = event.target instanceof Element ? event.target : null;
      if (!target || target.closest(".flyout")) return;
      event.preventDefault();
      toggleNavGroup(group);
    });
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest(".nav-group")) return;
    document.querySelectorAll(".nav-group.is-open").forEach((group) => {
      group.classList.remove("is-open");
      group.querySelector(".nav-toggle")?.setAttribute("aria-expanded", "false");
    });
  });
</script>
