---
import type { Sponsor, Team, TeamProfile } from "../lib/data";

type Props = {
  team: Team;
  profile?: TeamProfile;
  sponsors?: Sponsor[];
  compact?: boolean;
  showLink?: boolean;
};

const { team, profile, sponsors = [], compact = false, showLink = true } = Astro.props;
const isDarts = team.area === "darts";
const lineup = profile?.players.slice(0, 11) ?? [];
const substitutes = profile?.players.slice(11, compact ? 14 : 18) ?? [];
const lineupSlots = [
  "gk",
  "def-l",
  "def-cl",
  "def-cr",
  "def-r",
  "mid-l",
  "mid-c",
  "mid-r",
  "att-l",
  "att-c",
  "att-r"
];
---

<article class:list={["team-spotlight", compact && "team-spotlight-compact"]}>
  {team.image && <img class="team-spotlight-image" src={team.image} alt="" loading="lazy" />}
  <div class="team-spotlight-body">
    <p class="eyebrow">Teamvorstellung</p>
    <h3>{team.name}</h3>
    <p class="team-spotlight-lead">{profile?.headline ?? team.description}</p>
    {profile?.intro.map((paragraph) => <p>{paragraph}</p>)}

    {profile && (
      <div class="team-spotlight-meta">
        {profile.staff.map((person) => (
          <span><strong>{person.role}:</strong> {person.name}</span>
        ))}
      </div>
    )}

    {lineup.length > 0 && !isDarts && (
      <div class="pitch-lineup" aria-label={`Aufstellung ${team.name}`}>
        <span class="pitch-goal pitch-goal-top"></span>
        <span class="pitch-goal pitch-goal-bottom"></span>
        <span class="pitch-circle"></span>
        {lineup.map((player, index) => (
          <span class:list={["lineup-player", `lineup-${lineupSlots[index] ?? "bench"}`]}>
            {player.image && <img src={player.image} alt="" loading="lazy" />}
            <b>{player.number ?? "-"}</b>
            <span>{player.name}</span>
          </span>
        ))}
      </div>
    )}

    {lineup.length > 0 && isDarts && (
      <div class="player-strip player-strip-large" aria-label={`Spieler ${team.name}`}>
        {lineup.map((player) => (
          <span class="player-pill">
            {player.image && <img src={player.image} alt="" loading="lazy" />}
            <b>{player.number ?? player.position ?? "-"}</b>
            {player.name}
          </span>
        ))}
      </div>
    )}

    {substitutes.length > 0 && !isDarts && (
      <div class="player-strip" aria-label={`Kaderbank ${team.name}`}>
        {substitutes.map((player) => (
          <span class="player-pill">
            {player.image && <img src={player.image} alt="" loading="lazy" />}
            <b>{player.number ?? "-"}</b>
            {player.name}
          </span>
        ))}
      </div>
    )}

    {sponsors.length > 0 && (
      <div class="team-partners">
        {sponsors.map((sponsor) => (
          <a href={sponsor.website ?? "/verein/sponsoren"}>
            {sponsor.logoUrl && <img src={sponsor.logoUrl} alt="" loading="lazy" />}
            <span>{sponsor.name}</span>
          </a>
        ))}
      </div>
    )}

    {showLink && <a class="button secondary" href={`/teams/${team.slug}`}>Teamseite oeffnen</a>}
  </div>
</article>
