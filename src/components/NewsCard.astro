---
import type { NewsItem } from "../lib/data";

type Props = {
  item: NewsItem;
  compact?: boolean;
};

const { item, compact = false } = Astro.props;
const date = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" }).format(new Date(item.date));
---

<article class:list={["news-card", { compact }]}>
  {item.image && <img src={item.image} alt="" loading="lazy" />}
  <div>
    <p class="eyebrow">{item.category} · {date}</p>
    <h3>{item.title}</h3>
    <p>{item.teaser}</p>
    <div class="tag-row" aria-label="Zuordnungen">
      {item.areaTags.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</article>
