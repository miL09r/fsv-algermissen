---
import {
  clubFootballWidgets,
  footballWidgets,
  type FootballWidgetConfig,
  type Team
} from "../lib/data";

type WidgetVariant = "upcoming" | "latest" | "table" | "fixtures";

type Props = {
  team?: Team;
  variant: WidgetVariant;
};

const { team, variant } = Astro.props;

const labels: Record<WidgetVariant, string> = {
  upcoming: "Naechste Spiele",
  latest: "Letzte Ergebnisse",
  table: "Tabelle",
  fixtures: "Letzte/naechste Spiele"
};

const widgetKeys: Record<
  WidgetVariant,
  {
    id: keyof FootballWidgetConfig;
    type: keyof FootballWidgetConfig;
    defaultType: string;
  }
> = {
  upcoming: { id: "upcomingWidgetId", type: "upcomingWidgetType", defaultType: "matches" },
  latest: { id: "latestWidgetId", type: "latestWidgetType", defaultType: "results" },
  table: { id: "tableWidgetId", type: "tableWidgetType", defaultType: "table" },
  fixtures: { id: "fixtureWidgetId", type: "fixtureWidgetType", defaultType: "matches" }
};

const config = team ? footballWidgets[team.slug] : clubFootballWidgets;
const keys = widgetKeys[variant];
const widgetId = config?.[keys.id];
const widgetType = config?.[keys.type] ?? keys.defaultType;
const canRenderWidget = Boolean(widgetId && widgetType);
const externalUrl = config?.fussballDeUrl ?? "https://www.fussball.de/";
const contextLabel = team ? team.name : "Vereinsweit";
const meta = [
  ["Verein", team?.externalIds?.clubId],
  ["Team", team?.externalIds?.teamId],
  ["Wettbewerb", team?.externalIds?.leagueId]
].filter(([, value]) => value);
---

<section class:list={["football-widget", !canRenderWidget && "football-widget--missing"]} aria-label={labels[variant]}>
  <div class="football-widget-head">
    <div>
      <p class="eyebrow">FUSSBALL.DE</p>
      <h2>{labels[variant]}</h2>
    </div>
    <span>{contextLabel}</span>
  </div>

  {canRenderWidget ? (
    <>
      <div
        class="fussballde_widget"
        data-id={widgetId}
        data-type={widgetType}
      />
      <script is:inline>
        (() => {
          const loadFussballWidgets = () => {
            if (!document.querySelector(".fussballde_widget")) return;
            if (document.querySelector("script[data-fussball-widget-loader='true']")) return;

            const script = document.createElement("script");
            script.src = "https://www.fussball.de/widgets.js";
            script.async = true;
            script.dataset.fussballWidgetLoader = "true";
            document.head.append(script);
          };

          loadFussballWidgets();
          document.addEventListener("astro:page-load", loadFussballWidgets);
        })();
      </script>
    </>
  ) : (
    <div class="football-widget-empty">
      <p>
        Fuer {contextLabel} ist noch keine Widget-ID fuer diese Domain hinterlegt.
        Sobald der Code aus next.fussball.de vorliegt, wird dieses Feld automatisch
        zum Live-Widget.
      </p>

      {meta.length > 0 && (
        <dl class="football-widget-meta">
          {meta.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="football-widget-actions">
        <a class="button secondary" href={externalUrl}>Aktuelle Daten oeffnen</a>
      </div>
    </div>
  )}
</section>
