---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeamGrid from "../components/TeamGrid.astro";
import NewsCard from "../components/NewsCard.astro";
import { getNewsForArea } from "../lib/data";
import { getDb } from "../lib/server/auth";
import { getSiteTeams } from "../lib/server/teams";

const teams = await getSiteTeams(await getDb(Astro.locals));
const dartsTeams = teams.filter((team) => team.area === "darts");
const dartsNews = getNewsForArea("darts");
---

<BaseLayout title="Darts" description="Darts beim FSV Algermissen: A-Team, B-Team, C-Team, Training und News.">
  <header class="page-title">
    <p class="eyebrow">Darts</p>
    <h1>Magpies im FSV</h1>
    <p>Training montags und mittwochs jeweils um 19 Uhr im Clubhaus. A-, B- und C-Team werden als eigene Mannschaften gefuehrt.</p>
  </header>

  <section class="section">
    <div class="split">
      <article class="content-card">
        <p>
          Du moechtest dir Darten mal anschauen? Dann bist du bei uns genau richtig.
          Zum Training ist jeder herzlich willkommen.
        </p>
        <p>
          Bei Fragen erreicht ihr uns per Telefon oder WhatsApp unter 0151 20253112
          oder per E-Mail an sebastian.boes@yahoo.de.
        </p>
      </article>
      <aside class="content-card">
        <h2>Darts-Teams</h2>
        {dartsTeams.map((team) => <p>{team.shortName}: {team.league ?? "Spielbetrieb"}</p>)}
      </aside>
    </div>
  </section>

  <TeamGrid teams={dartsTeams} title="Darts-Teams" />

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Aktuelles</p>
        <h2>Darts-News</h2>
      </div>
      <p>Darts-Beitraege laufen im zentralen News-System mit.</p>
    </div>
    <div class="news-grid">
      {dartsNews.map((item) => <NewsCard item={item} />)}
    </div>
  </section>
</BaseLayout>
