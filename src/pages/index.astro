---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../components/NewsCard.astro";
import TeamGrid from "../components/TeamGrid.astro";
import MatchCenter from "../components/MatchCenter.astro";
import ResultBanner from "../components/ResultBanner.astro";
import SponsorMarquee from "../components/SponsorMarquee.astro";
import TeamSpotlight from "../components/TeamSpotlight.astro";
import {
  clubPages,
  filterSponsors,
  getFeaturedResults,
  getNewsForArea,
  getPublishedNews,
  getSponsorsForTeam,
  getTeamProfile,
  sponsors,
  teams
} from "../lib/data";
import { getDb } from "../lib/server/auth";
import { getSiteMatchResults } from "../lib/server/match-results";

const latestNews = getPublishedNews().slice(0, 5);
const youthNews = getNewsForArea("jugend").slice(0, 2);
const dartsNews = getNewsForArea("darts").slice(0, 2);
const heroResults = getFeaturedResults(["1-herren", "2-herren", "a-junioren", "ue32"], 1);
const spotlightTeams = teams.filter((team) => ["1-herren", "2-herren", "a-junioren", "ue32"].includes(team.slug));
const topNews = latestNews[0];
const matchcenterResults = await getSiteMatchResults(await getDb(Astro.locals));
---

<BaseLayout title="FSV Algermissen" description="Die neue Website des gesamten FSV Algermissen: Fussball, Jugend, Darts, Verein und Sponsoren.">
  <section class="hero">
    <div class="hero-shell">
      <div class="hero-content">
        <p class="eyebrow">FSV Algermissen v. 1911 / 1990 e.V.</p>
        <h1>FSV Algermissen</h1>
        <p>
          Fussball, Jugend, Darts und Vereinsleben: kompakt, aktuell und mitten im Dorf.
        </p>
        <div class="hero-actions">
          <a class="button" href="/news">News lesen</a>
          <a class="button secondary" href="/teams/1-herren">Zu den Teams</a>
        </div>
      </div>
      <div class="hero-crest" aria-hidden="true">
        <img
          src="https://images.ebcdn.de/club-4844/logo.png?format=webp&height=1200&mode=crop&v=2&width=1200"
          alt=""
          width="220"
          height="220"
          loading="eager"
        />
      </div>
      <aside class="hero-panel" aria-label="Aktuelles im Banner">
        <ResultBanner results={heroResults} />
        {topNews && (
          <a class="hero-news" href="/news">
            <span>Top-News</span>
            <strong>{topNews.title}</strong>
            <small>{topNews.teaser}</small>
          </a>
        )}
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Aktuelles</p>
        <h2>News aus dem ganzen Verein</h2>
      </div>
      <p>Berichte, Termine und Geschichten aus allen Bereichen des Vereins.</p>
    </div>
    <div class="news-grid">
      {latestNews.map((item) => <NewsCard item={item} />)}
    </div>
  </section>

  <section class="section band">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Matchcenter</p>
        <h2>Spiele und Ergebnisse</h2>
      </div>
      <p>Letzte Ergebnisse und kommende Spiele im FSV-Look.</p>
    </div>
    <div class="matchcenter-home">
      <MatchCenter results={matchcenterResults} />
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Teamvorstellung</p>
        <h2>Teams im Fokus</h2>
      </div>
      <p>Aktuelle Mannschaften, Ansprechpartner, Partner und Spieler auf einen Blick.</p>
    </div>
    <div class="spotlight-grid">
      {spotlightTeams.map((team) => (
        <TeamSpotlight
          team={team}
          profile={getTeamProfile(team.slug)}
          sponsors={getSponsorsForTeam(team.slug)}
          compact
        />
      ))}
    </div>
  </section>

  <TeamGrid teams={teams.filter((team) => team.area === "senioren")} title="Herren und Senioren" />

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Jugend / JSG Nord</p>
        <h2>Von Bambinis bis A-Junioren</h2>
      </div>
      <p>Die Jugendarbeit der JSG Nord vom Einstieg bis zu den A-Junioren.</p>
    </div>
    <div class="split">
      <TeamGrid teams={teams.filter((team) => team.area === "jugend")} />
      <div class="side-panel">
        <h3>Aktuelles aus der Jugend</h3>
        {youthNews.map((item) => <NewsCard item={item} compact />)}
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Darts</p>
        <h2>Magpies im Clubhaus</h2>
      </div>
      <p>Darts ist ein eigener Vereinsbereich mit A-, B- und C-Team, Training, Kontakt und News.</p>
    </div>
    <div class="split">
      <TeamGrid teams={teams.filter((team) => team.area === "darts")} />
      <div class="side-panel dark">
        <h3>Darts-News</h3>
        {dartsNews.map((item) => <NewsCard item={item} compact />)}
        <a class="button" href="/darts">Darts-Bereich oeffnen</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Vereinsleben</p>
        <h2>Vorstand, Clubhaus und Sportstaetten</h2>
      </div>
      <p>Alles rund um Verantwortung, Sportstaetten, Foerderung und Vereinsservice.</p>
    </div>
    <div class="feature-grid">
      {clubPages.slice(0, 6).map((page) => (
        <a class="feature-card" href={`/verein/${page.slug}`}>
          <h3>{page.title}</h3>
          <p>{page.teaser}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Partner</p>
        <h2>Sponsoren des FSV</h2>
      </div>
      <p>Starke Partner aus der Region, die den FSV und seine Mannschaften unterstuetzen.</p>
    </div>
    <SponsorMarquee sponsors={sponsors} />
    <div class="sponsor-grid">
      {filterSponsors("Premium-Partner").concat(filterSponsors("Exklusiv-Partner")).slice(0, 6).map((sponsor) => (
        <a class="sponsor-card" href={sponsor.website ?? "/verein/sponsoren"}>
          <p class="eyebrow">{sponsor.category}</p>
          <h3>{sponsor.name}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="section band">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Mitglied werden</p>
        <h2>Mitmachen beim FSV Algermissen</h2>
      </div>
      <p>Der neue Auftritt fuehrt Mitglieder, Foerderer und Fans schneller zu Ansprechpartnern, Downloads und Vereinsbereichen.</p>
    </div>
    <div class="action-row">
      <a class="button" href="/verein/downloads">Formulare</a>
      <a class="button secondary" href="/verein/foerderverein">Foerderverein</a>
    </div>
  </section>
</BaseLayout>
