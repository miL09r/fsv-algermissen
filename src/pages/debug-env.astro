---
export const prerender = false;

let workerKeys: string[] = [];
try {
  const workerModule = await import("cloudflare:workers");
  workerKeys = Object.keys(workerModule.env ?? {});
} catch {
  workerKeys = [];
}

const localKeys = Object.keys((Astro.locals as { runtime?: { env?: Record<string, unknown> } }).runtime?.env ?? {});
---

<pre>{JSON.stringify({ localKeys, workerKeys })}</pre>
