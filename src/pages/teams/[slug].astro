---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import MatchCenter from "../../components/MatchCenter.astro";
import ResultBanner from "../../components/ResultBanner.astro";
import TeamSpotlight from "../../components/TeamSpotlight.astro";
import {
  getNewsForTeam,
  getSponsorsForTeam,
  getTeamProfile,
  teams
} from "../../lib/data";
import { getDb } from "../../lib/server/auth";
import { getSiteMatchResults } from "../../lib/server/match-results";

export const prerender = false;

const slug = String(Astro.params.slug ?? "");
const team = teams.find((item) => item.slug === slug);
if (!team) return Astro.redirect("/");

const teamNews = getNewsForTeam(team.slug);
const teamProfile = getTeamProfile(team.slug);
const teamResults = (await getSiteMatchResults(await getDb(Astro.locals), [team.slug])).slice(0, 8);
const teamSponsors = getSponsorsForTeam(team.slug);
---

<BaseLayout title={team.name} description={`${team.name} beim FSV Algermissen: News, Training, Ansprechpartner und Spielbetrieb.`}>
  <header class="page-title">
    <p class="eyebrow">{team.area}</p>
    <h1>{team.name}</h1>
    <p>{team.description}</p>
  </header>

  <section class="section">
    <div class="split">
      <div>
        <TeamSpotlight team={team} profile={teamProfile} sponsors={teamSponsors} showLink={false} />
        <div class="feature-grid" style="margin-top: 18px;">
          <div class="feature-card">
            <h3>Training</h3>
            {team.trainingTimes.map((time) => <p>{time}</p>)}
            {team.trainingLocation && <p><strong>Ort:</strong> {team.trainingLocation}</p>}
          </div>
          <div class="feature-card">
            <h3>Ansprechpartner</h3>
            {team.contacts.map((contact) => (
              <p><strong>{contact.role}:</strong> {contact.name}</p>
            ))}
          </div>
          <div class="feature-card">
            <h3>Wettbewerb</h3>
            <p>{team.league ?? "Aktueller Spielbetrieb beim FSV Algermissen"}</p>
          </div>
        </div>
      </div>
      <div>
        {teamResults.length > 0 && <ResultBanner results={teamResults.slice(0, 5)} />}
        <MatchCenter results={teamResults} team={team} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Team-News</p>
        <h2>Aktuelles zu {team.shortName}</h2>
      </div>
      <p>Berichte und Meldungen rund um diese Mannschaft.</p>
    </div>
    <div class="news-grid">
      {teamNews.length > 0 ? teamNews.map((item) => <NewsCard item={item} />) : (
        <div class="content-card">
          <h3>Noch keine zugeordneten News</h3>
          <p>Sobald es neue Meldungen gibt, erscheinen sie hier auf der Teamseite.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
