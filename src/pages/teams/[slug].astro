---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsCard from "../../components/NewsCard.astro";
import MatchCenter from "../../components/MatchCenter.astro";
import TeamSpotlight from "../../components/TeamSpotlight.astro";
import {
  getNewsForTeam,
  getSponsorsForTeam,
} from "../../lib/data";
import { getDb } from "../../lib/server/auth";
import { getSiteMatchResults } from "../../lib/server/match-results";
import { getSiteTeam, getSiteTeamProfile } from "../../lib/server/teams";

export const prerender = false;

const slug = String(Astro.params.slug ?? "");
const db = await getDb(Astro.locals);
const team = await getSiteTeam(db, slug);
if (!team) return Astro.redirect("/");

const teamNews = getNewsForTeam(team.slug);
const teamProfile = await getSiteTeamProfile(db, team.slug);
const teamResults = (await getSiteMatchResults(db, [team.slug])).slice(0, 8);
const teamSponsors = getSponsorsForTeam(team.slug);
---

<BaseLayout title={team.name} description={`${team.name} beim FSV Algermissen: News, Training, Ansprechpartner und Spielbetrieb.`}>
  <header class="page-title">
    <p class="eyebrow">{team.area}</p>
    <h1>{team.name}</h1>
    <p>{team.description}</p>
  </header>

  <section class="section">
    <div class="team-detail-layout">
      <div class="team-detail-main">
        <TeamSpotlight team={team} profile={teamProfile} sponsors={teamSponsors} showLink={false} detail />
        <div class="feature-grid team-facts">
          <div class="feature-card">
            <h3>Training</h3>
            {team.trainingTimes.map((time) => <p>{time}</p>)}
            {team.trainingLocation && <p><strong>Ort:</strong> {team.trainingLocation}</p>}
          </div>
          <div class="feature-card">
            <h3>Ansprechpartner</h3>
            {team.contacts.map((contact) => (
              <p><strong>{contact.role}:</strong> {contact.name}</p>
            ))}
          </div>
          <div class="feature-card">
            <h3>Wettbewerb</h3>
            <p>{team.league ?? "Aktueller Spielbetrieb beim FSV Algermissen"}</p>
          </div>
        </div>
      </div>
      <aside class="team-detail-aside">
        <MatchCenter results={teamResults} team={team} compact />
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Team-News</p>
        <h2>Aktuelles zu {team.shortName}</h2>
      </div>
      <p>Berichte und Meldungen rund um diese Mannschaft.</p>
    </div>
    <div class="news-grid">
      {teamNews.length > 0 ? teamNews.map((item) => <NewsCard item={item} />) : (
        <div class="content-card">
          <h3>Aktuell keine Team-News</h3>
          <p>Neue Meldungen rund um {team.shortName} folgen hier.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
