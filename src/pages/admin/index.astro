---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { teams } from "../../lib/data";
import { getCurrentUser, getDb } from "../../lib/server/auth";

export const prerender = false;

type RegistrationRequest = {
  id: number;
  email: string;
  name: string;
  requested_scope: string | null;
  created_at: string;
};

const db = await getDb(Astro.locals);
const user = await getCurrentUser(db, Astro.cookies);
const isAdmin = user?.role === "admin";
const pendingRequests =
  db && isAdmin
    ? (
        await db
          .prepare(
            `SELECT id, email, name, requested_scope, created_at
             FROM registration_requests
             WHERE status = 'pending'
             ORDER BY created_at DESC`
          )
          .all<RegistrationRequest>()
      ).results
    : [];
const editableTeams = teams;
const message = Astro.url.searchParams;
---

<BaseLayout title="Login Bereich" description="Redaktionsbereich des FSV Algermissen.">
  <header class="page-title">
    <p class="eyebrow">Redaktion</p>
    <h1>{user ? `Willkommen, ${user.name}` : "Login Bereich"}</h1>
    <p>{user ? "Inhalte, Benutzer und Mannschaftsbereiche verwalten." : "Anmelden oder Zugang fuer die Redaktion beantragen."}</p>
  </header>

  <section class="section">
    {!db && (
      <div class="content-card">
        <h2>Datenbank nicht verbunden</h2>
        <p>Der Redaktionsbereich braucht die Cloudflare-D1-Bindung <strong>DB</strong>.</p>
      </div>
    )}

    {!user ? (
      <div class="admin-grid">
        <form class="admin-panel form-grid" method="post" action="/api/admin/login">
          <h2>Anmelden</h2>
          {message.get("error") === "login" && <p class="status-pill danger">Login fehlgeschlagen</p>}
          <label>
            E-Mail
            <input type="email" name="email" autocomplete="username" required />
          </label>
          <label>
            Passwort
            <input type="password" name="password" autocomplete="current-password" required />
          </label>
          <button class="button" type="submit">Einloggen</button>
        </form>

        <form class="admin-panel form-grid" method="post" action="/api/admin/register">
          <h2>Zugang beantragen</h2>
          {message.get("register") === "pending" && <p class="status-pill">Anfrage wurde gesendet</p>}
          <label>
            Name
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            E-Mail
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Passwort
            <input type="password" name="password" autocomplete="new-password" minlength="10" required />
          </label>
          <p class="form-note">Nach der Anfrage wird festgelegt, welche Bereiche freigeschaltet werden.</p>
          <button class="button secondary" type="submit">Registrierung senden</button>
        </form>
      </div>
    ) : (
      <div class="admin-grid">
        <div class="admin-panel">
          <h2>Bereiche</h2>
          <p><strong>Rolle:</strong> {user.role}</p>
          <div class="action-row">
            <a class="button" href="/admin/news">News verwalten</a>
            <a class="button secondary" href="/admin/teams">Teams & Ergebnisse</a>
          </div>
          <form method="post" action="/api/admin/logout" style="margin-top: 14px;">
            <button class="button ghost" type="submit">Ausloggen</button>
          </form>
        </div>

        {isAdmin && (
          <div class="admin-panel">
            <h2>Registrierungen freigeben</h2>
            {message.get("approve") === "ok" && <p class="status-pill">Benutzer freigegeben</p>}
            {pendingRequests.length === 0 ? (
              <p>Keine offenen Registrierungen.</p>
            ) : (
              pendingRequests.map((request) => (
                <form class="approval-card" method="post" action="/api/admin/users/approve">
                  <input type="hidden" name="requestId" value={request.id} />
                  <h3>{request.name}</h3>
                  <p>{request.email}</p>
                  <label>
                    Rolle
                    <select name="role">
                      <option value="team_editor">Team-Redakteur</option>
                      <option value="editor">Redakteur</option>
                      <option value="admin">Admin</option>
                    </select>
                  </label>
                  <fieldset>
                    <legend>Inhaltsbereiche</legend>
                    <label><input type="checkbox" name="content" value="haupt-news" /> Haupt-News</label>
                    <label><input type="checkbox" name="content" value="verein" /> Verein</label>
                    <label><input type="checkbox" name="content" value="sponsoren" /> Sponsoren</label>
                  </fieldset>
                  <fieldset>
                    <legend>Mannschaften</legend>
                    {editableTeams.map((team) => (
                      <label><input type="checkbox" name="teams" value={team.slug} /> {team.name}</label>
                    ))}
                  </fieldset>
                  <label class="inline-check"><input type="checkbox" name="canPublish" /> darf veroeffentlichen</label>
                  <button class="button" type="submit">Freigeben</button>
                </form>
              ))
            )}
          </div>
        )}
      </div>
    )}
  </section>
</BaseLayout>
