---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import { getResultsForTeam } from "../../lib/data";
import { getCurrentUser, getDb } from "../../lib/server/auth";
import { getSiteTeamProfile, getSiteTeams } from "../../lib/server/teams";

export const prerender = false;

const db = await getDb(Astro.locals);
const user = await getCurrentUser(db, Astro.cookies);
if (!user) return Astro.redirect("/admin?error=auth");

const message = new URL(Astro.request.url).searchParams;
const profileTeams = await getSiteTeams(db, { includeInactive: true });
const resultTeams = profileTeams.filter((team) => team.area === "darts" || team.trainingTimes.length >= 0);
const profiles = new Map(
  await Promise.all(profileTeams.map(async (team) => [team.slug, await getSiteTeamProfile(db, team.slug)] as const))
);
const teamGroups = [
  { id: "fussball", label: "Fußball / Senioren", teams: profileTeams.filter((team) => team.area === "senioren") },
  { id: "jugend", label: "Jugend / JSG", teams: profileTeams.filter((team) => team.area === "jugend") },
  { id: "darts", label: "Darts", teams: profileTeams.filter((team) => team.area === "darts") }
];
const positionOptions = [
  "Torwart",
  "Abwehr links",
  "Abwehr Mitte links",
  "Abwehr Mitte rechts",
  "Abwehr rechts",
  "Mittelfeld links",
  "Mittelfeld zentral",
  "Mittelfeld rechts",
  "Angriff links",
  "Sturm",
  "Angriff rechts",
  "Darts Spieler"
];
---

<BaseLayout title="Teams verwalten" description="Teamvorstellungen, Kader und Ergebnisse verwalten.">
  <header class="page-title">
    <p class="eyebrow">Redaktion</p>
    <h1>Teamprofile und Ergebnisse</h1>
    <p>Teamvorstellungen, Kaderauszuege, Sponsoren und Ergebnisbanner verwalten.</p>
  </header>

  <section class="section">
    {message.get("team") === "ok" && <p class="status-pill">Team wurde gespeichert</p>}
    {message.get("team") === "invalid" && <p class="status-pill danger">Teamdaten unvollstaendig</p>}
    {message.get("team") === "forbidden" && <p class="status-pill danger">Keine Berechtigung fuer dieses Team</p>}
    <div class="admin-workspace">
      <AdminNav active="teams" />
      <div class="admin-layout">
        <aside class="admin-side-menu">
          <strong>Teams</strong>
          <a href="#ergebnisse">Ergebnisse</a>
          <a href="#fussball">Fußball / Senioren</a>
          <a href="#jugend">Jugend / JSG</a>
          <a href="#darts">Darts</a>
          <a href="#ueberblick">Überblick</a>
        </aside>
        <div class="admin-main">
      <form id="ergebnisse" class="admin-panel form-grid" method="post" action="/api/admin/results/create">
        <h2>Ergebnis eintragen</h2>
        {message.get("result") === "ok" && <p class="status-pill">Ergebnis wurde gespeichert</p>}
        {message.get("result") === "invalid" && <p class="status-pill danger">Bitte Team, Ergebnis und Datum pruefen</p>}
        {message.get("result") === "forbidden" && <p class="status-pill danger">Keine Berechtigung fuer dieses Team</p>}
        <label>
          Team
          <select name="resultTeam">
            {resultTeams.map((team) => <option value={team.slug}>{team.name}</option>)}
          </select>
        </label>
        <label>
          Heimteam
          <input name="homeTeam" />
        </label>
        <label>
          Auswaertsteam
          <input name="awayTeam" />
        </label>
        <label>
          Ergebnis
          <input name="score" placeholder="2:1" />
        </label>
        <label>
          Datum
          <input type="date" name="date" />
        </label>
        <label>
          Wettbewerb
          <input name="competition" placeholder="Liga / Pokal / Spieltag" />
        </label>
        <label>
          Spieltag
          <input name="matchday" placeholder="z.B. 4. Spieltag" />
        </label>
        <label class="inline-check">
          <input type="checkbox" name="showOnHomepage" checked />
          Auf Startseite anzeigen
        </label>
        <button class="button" type="submit">Ergebnis speichern</button>
      </form>

      <form class="admin-panel form-grid" method="post" action="/api/admin/results/import">
        <h2>FUSSBALL.DE Import</h2>
        {message.get("import") === "ok" && <p class="status-pill">Import wurde verarbeitet</p>}
        {message.get("import") === "empty" && <p class="status-pill danger">Keine verwertbaren Spiele gefunden</p>}
        {message.get("import") === "missing" && <p class="status-pill danger">Bitte FUSSBALL.DE Adresse eintragen</p>}
        <p class="form-note">Dieser Import liest Ergebnisse serverseitig aus und speichert sie in unserem Design. Auf der Website wird kein FUSSBALL.DE Widget angezeigt.</p>
        <label>
          Team
          <select name="resultTeam">
            {resultTeams.filter((team) => team.area !== "darts").map((team) => <option value={team.slug}>{team.name}</option>)}
          </select>
        </label>
        <label>
          FUSSBALL.DE Team- oder Spielplan-Adresse
          <input name="sourceUrl" placeholder="https://www.fussball.de/..." />
          <span class="field-hint">Die Adresse wird nur fuer den Import genutzt. Darts-Ergebnisse bleiben manuell.</span>
        </label>
        <label class="inline-check">
          <input type="checkbox" name="showOnHomepage" checked />
          Importierte Ergebnisse auf der Startseite anzeigen
        </label>
        <button class="button secondary" type="submit">FUSSBALL.DE Daten einlesen</button>
      </form>

      {teamGroups.map((group) => (
        <section id={group.id} class="admin-team-group">
          <div class="admin-section-title">
            <p class="eyebrow">{group.label}</p>
            <h2>{group.teams.length} Bereich(e) pflegen</h2>
          </div>
          {group.teams.map((team) => {
            const profile = profiles.get(team.slug);
            return (
          <details id={`team-${team.slug}`} class="admin-panel admin-accordion" open={team.slug === "1-herren"}>
            <summary>
              <span>{team.name}</span>
              <small>{team.isActive === false ? "Inaktiv" : "Aktiv"} · {team.league ?? team.area}</small>
            </summary>
            <form class="form-grid" method="post" action="/api/admin/teams/update" enctype="multipart/form-data">
            <input type="hidden" name="teamSlug" value={team.slug} />
            <label class="inline-check">
              <input type="checkbox" name="isActive" checked={team.isActive !== false} />
              In Navigation und Seiten anzeigen
            </label>
            <label>
              Bereich
              <select name="area">
                <option value="senioren" selected={team.area === "senioren"}>Fussball / Senioren</option>
                <option value="jugend" selected={team.area === "jugend"}>Jugend / JSG</option>
                <option value="darts" selected={team.area === "darts"}>Darts</option>
              </select>
            </label>
            <label>
              Teamname
              <input name="name" value={team.name} required />
            </label>
            <label>
              Navigationsname
              <input name="shortName" value={team.shortName} required />
            </label>
            <label>
              Jahrgang / Altersklasse
              <input name="ageGroup" value={team.ageGroup ?? ""} />
            </label>
            <label>
              Liga / Wettbewerb
              <input name="league" value={team.league ?? ""} />
            </label>
            <label>
              Trainingsort
              <input name="trainingLocation" value={team.trainingLocation ?? ""} />
            </label>
            <label>
              Beschreibung
              <textarea name="description" required>{team.description}</textarea>
            </label>
            <div class="upload-field">
              <label>
                Teamfoto hochladen
                <input type="file" name="teamImage" accept="image/*" />
              </label>
              <p class="field-hint">Direkt vom Computer hochladen. Dieses Bild wird fuer Teamkarte, Teamseite und Teamvorstellung genutzt.</p>
            </div>
            <label>
              Alternativ Teamfoto-URL
              <input name="imageUrl" value={team.image ?? ""} />
              <span class="field-hint">Nur noetig, wenn das Bild bereits online liegt.</span>
            </label>
            <label>
              Trainingszeiten
              <textarea name="trainingTimes" placeholder="Donnerstag; 19:00; 21:00; Clubhaus; Training">{team.trainingTimes.join("\n")}</textarea>
            </label>
            <label>
              Kontakte
              <textarea name="contacts" placeholder="Trainer; Max Mustermann; mail@example.de; 0151...">{team.contacts.map((contact) => [contact.role, contact.name, contact.email ?? "", contact.phone ?? ""].join("; ")).join("\n")}</textarea>
            </label>
            <label>
              Ueberschrift Teamvorstellung
              <input name="headline" value={profile?.headline ?? ""} />
            </label>
            <label>
              Vorstellungstext
              <textarea name="intro" placeholder="Absatz 1&#10;&#10;Absatz 2">{profile?.intro.join("\n\n") ?? ""}</textarea>
            </label>
            <div class="player-editor" data-player-editor>
              <div class="player-editor-head">
                <div>
                  <strong>Spieler und Positionen</strong>
                  <p class="form-note">Name, Position und Bild steuern direkt die Teamvorstellung. Bei Fussball-Teams setzt die Position den Spieler auf den Platz.</p>
                </div>
                <button class="button secondary" type="button" data-add-player>Spieler hinzufuegen</button>
              </div>
              <textarea name="players" data-player-output hidden>{profile?.players.map((player) => [player.name, player.number ?? "", player.position ?? "", player.image ?? "", "", player.bio ?? ""].join("; ")).join("\n") ?? ""}</textarea>
              <div class="player-list" data-player-list>
                {(profile?.players ?? []).map((player) => (
                  <div class="player-row" data-player-row>
                    <label>
                      Name
                      <input data-player-field="name" value={player.name} placeholder="Max Mustermann" />
                    </label>
                    <label>
                      Nr.
                      <input data-player-field="number" value={player.number ?? ""} placeholder="10" />
                    </label>
                    <label>
                      Position
                      <select data-player-field="position">
                        <option value="" selected={!player.position}>Bitte waehlen</option>
                        {positionOptions.map((position) => (
                          <option value={position} selected={player.position === position}>{position}</option>
                        ))}
                      </select>
                    </label>
                    <label>
                      Bild-URL
                      <input data-player-field="image" value={player.image ?? ""} placeholder="/api/media/..." />
                    </label>
                    <label class="player-row-wide">
                      Kurztext
                      <textarea data-player-field="bio" placeholder="Kurzer Hinweis zum Spieler">{player.bio ?? ""}</textarea>
                    </label>
                    <button class="button ghost" type="button" data-remove-player>Entfernen</button>
                  </div>
                ))}
              </div>
              <p class="form-note">Spielerbilder werden zeilenweise zugeordnet: Der erste Upload gehoert zum ersten Spieler, der zweite Upload zum zweiten Spieler.</p>
            </div>
            <label>
              Spielerbilder hochladen
              <input type="file" name="playerImages" accept="image/*" multiple />
              <span class="field-hint">Mehrere Bilder auswaehlen. Die Reihenfolge entspricht der Spielerliste oben.</span>
            </label>
            <p class="form-note">Spielerbilder werden zeilenweise zugeordnet. Zeile 1 im Kader bekommt Bild 1, Zeile 2 bekommt Bild 2.</p>
            <button class="button" type="submit">Team speichern</button>
            </form>
          </details>
            );
          })}
        </section>
      ))}
        </div>
      </div>
    </div>
  </section>

  <section id="ueberblick" class="section band">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Aktuelle Daten</p>
        <h2>Was schon auf der Seite erscheint</h2>
      </div>
      <p>Diese Inhalte erscheinen aktuell auf der Website.</p>
    </div>
    <div class="feature-grid">
      {resultTeams.slice(0, 9).map((team) => {
        const profile = profiles.get(team.slug);
        const results = getResultsForTeam(team.slug);
        return (
          <div class="feature-card">
            <h3>{team.name}</h3>
            <p>{profile?.headline ?? team.description}</p>
            <p>{results.length} Ergebnis(se) im Banner-Datenmodell</p>
          </div>
        );
      })}
    </div>
  </section>
  <script>
    const positionOptions = [
      "Torwart",
      "Abwehr links",
      "Abwehr Mitte links",
      "Abwehr Mitte rechts",
      "Abwehr rechts",
      "Mittelfeld links",
      "Mittelfeld zentral",
      "Mittelfeld rechts",
      "Angriff links",
      "Sturm",
      "Angriff rechts",
      "Darts Spieler"
    ];

    const clean = (value: unknown) => String(value ?? "").replace(/;/g, ",").trim();

    const createPlayerRow = () => {
      const row = document.createElement("div");
      row.className = "player-row";
      row.dataset.playerRow = "";
      row.innerHTML = `
        <label>Name<input data-player-field="name" placeholder="Max Mustermann"></label>
        <label>Nr.<input data-player-field="number" placeholder="10"></label>
        <label>Position<select data-player-field="position"><option value="">Bitte waehlen</option>${positionOptions
          .map((position) => `<option value="${position}">${position}</option>`)
          .join("")}</select></label>
        <label>Bild-URL<input data-player-field="image" placeholder="/api/media/..."></label>
        <label class="player-row-wide">Kurztext<textarea data-player-field="bio" placeholder="Kurzer Hinweis zum Spieler"></textarea></label>
        <button class="button ghost" type="button" data-remove-player>Entfernen</button>
      `;
      return row;
    };

    document.querySelectorAll("[data-player-editor]").forEach((editor) => {
      const list = editor.querySelector("[data-player-list]");
      const output = editor.querySelector("[data-player-output]");
      const sync = () => {
        if (!(output instanceof HTMLTextAreaElement)) return;
        const rows = Array.from(editor.querySelectorAll("[data-player-row]"));
        output.value = rows
          .map((row) => {
            const value = (field: string) => {
              const input = row.querySelector(`[data-player-field="${field}"]`);
              return input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement
                ? input.value
                : "";
            };
            return [value("name"), value("number"), value("position"), value("image"), "", value("bio")].map(clean).join("; ");
          })
          .filter((line) => line.split(";")[0]?.trim())
          .join("\n");
      };

      editor.querySelector("[data-add-player]")?.addEventListener("click", () => {
        list?.append(createPlayerRow());
        sync();
      });

      editor.addEventListener("input", sync);
      editor.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement) || !target.matches("[data-remove-player]")) return;
        target.closest("[data-player-row]")?.remove();
        sync();
      });
      editor.closest("form")?.addEventListener("submit", sync);
      sync();
    });
  </script>
</BaseLayout>
