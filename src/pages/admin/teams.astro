---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getResultsForTeam, getTeamProfile, teams } from "../../lib/data";
import { getCurrentUser, getDb } from "../../lib/server/auth";

export const prerender = false;

const user = await getCurrentUser(await getDb(Astro.locals), Astro.cookies);
if (!user) return Astro.redirect("/admin?error=auth");

const editableTeams = teams.filter((team) => team.area !== "darts");
---

<BaseLayout title="Teams verwalten" description="Teamvorstellungen, Kader und Ergebnisse verwalten.">
  <header class="page-title">
    <p class="eyebrow">Redaktion</p>
    <h1>Teamprofile und Ergebnisse</h1>
    <p>Teamvorstellungen, Kaderauszuege, Sponsoren und Ergebnisbanner verwalten.</p>
  </header>

  <section class="section">
    <div class="admin-grid">
      <form class="admin-panel form-grid">
        <h2>Teamvorstellung pflegen</h2>
        <label>
          Team
          <select name="team">
            {editableTeams.map((team) => <option value={team.slug}>{team.name}</option>)}
          </select>
        </label>
        <label>
          Ueberschrift
          <input name="headline" placeholder="Kreisliga-Fussball in der REWE-Rudat-Arena" />
        </label>
        <label>
          Vorstellungstext
          <textarea name="intro" placeholder="Trainingszeiten, Trainer, Liga, Team-Partner ..."></textarea>
        </label>
        <label>
          Spieler/Kader
          <textarea name="players" placeholder="Name; Rueckennummer; Bild-URL"></textarea>
        </label>
        <button class="button" type="button">Speichern</button>
      </form>

      <form class="admin-panel form-grid">
        <h2>Ergebnis eintragen</h2>
        <label>
          Team
          <select name="resultTeam">
            {editableTeams.map((team) => <option value={team.slug}>{team.name}</option>)}
          </select>
        </label>
        <label>
          Heimteam
          <input name="homeTeam" />
        </label>
        <label>
          Auswaertsteam
          <input name="awayTeam" />
        </label>
        <label>
          Ergebnis
          <input name="score" placeholder="2:1" />
        </label>
        <label>
          Datum
          <input type="date" name="date" />
        </label>
        <button class="button" type="button">Ergebnis speichern</button>
      </form>
    </div>
  </section>

  <section class="section band">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Aktuelle Daten</p>
        <h2>Was schon auf der Seite erscheint</h2>
      </div>
      <p>Diese Inhalte erscheinen aktuell auf der Website.</p>
    </div>
    <div class="feature-grid">
      {editableTeams.slice(0, 6).map((team) => {
        const profile = getTeamProfile(team.slug);
        const results = getResultsForTeam(team.slug);
        return (
          <div class="feature-card">
            <h3>{team.name}</h3>
            <p>{profile?.headline ?? team.description}</p>
            <p>{results.length} Ergebnis(se) im Banner-Datenmodell</p>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
